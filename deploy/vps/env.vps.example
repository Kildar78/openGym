# openGym sur un VPS, derrière un reverse proxy HTTPS, sur un sous-domaine.
# install.sh copie ce fichier en ../../.env et remplace gym.example.com par votre domaine.
# Toutes les autres options sont dans ../../.env.example et docs/SELF_HOSTING.md.

# Les passkeys sont liées à ce nom exact : choisissez-le AVANT que quelqu'un crée un profil.
# Le changer plus tard rend toutes les passkeys existantes inutilisables.
RP_ID=gym.example.com
# Jamais de chemin ni de slash final ici.
ORIGIN=https://gym.example.com
RP_NAME=openGym

# Le conteneur web n'écoute que sur la boucle locale : seul le reverse proxy du VPS le joint,
# il n'est pas exposé directement sur Internet.
WEB_PORT=127.0.0.1:8080

# Le premier profil créé sur l'instance vide devient admin. Créez le vôtre en premier.
FIRST_USER_ADMIN=1

# Après avoir créé votre profil, décommentez pour que seuls les invités puissent s'inscrire
# (codes d'invitation dans le tableau de bord admin), puis : docker compose up -d
#INVITE_ONLY=1
#ALLOW_GUEST=0

# Instance publique : des sessions un peu plus courtes que les 90 jours par défaut.
SESSION_DAYS=30

# Langue par défaut de l'écran de connexion et des nouveaux profils.
DEFAULT_LANG=fr

# Contact pour les services de notification push (facultatif, par défaut ORIGIN).
#VAPID_SUBJECT=mailto:vous@example.com

# Seulement si Cloudflare (proxy orange ou tunnel) est devant le VPS. Garder les guillemets simples.
#CF_CONNECTING_IP='$http_cf_connecting_ip'
